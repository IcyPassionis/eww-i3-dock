(deflisten app-buttons
  :initial "(box)"
  "/home/boncuk/.config/eww/dock-apps.py --listen")

; Context-menu popover state. Set by dock-ctx.sh on right-click, cleared by
; dock-menu.sh after an action and by the show/hide scripts on transitions.
(defvar menu-open false)
(defvar menu-pinned false)
(defvar menu-running false)
(defvar menu-has-desktop false)
; Submenu state for "Move to workspace". Reset alongside menu-open everywhere
; (ctx open, menu action, show/hide transitions) so it never opens stale.
(defvar menu-move-open false)

(defwindow dock_open_area
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "760px" :height "4px" :anchor "bottom center")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore true
  :class "dock-open-area"
  (eventbox
    ; Keep the single event-driven listener alive when only the trigger is open.
    ; The initial (box) is nonempty, so cold-start edge hover remains active.
    :active {app-buttons != ""}
    :onhover "/home/boncuk/.config/eww/dock-show.sh"
    ; Record trigger exit against the pending show token. This is only a
    ; pre-open stale-show hint; it does not replace the show request, because
    ; Eww can synthesize this crossing when the trigger is swapped for dock.
    :onhoverlost "/home/boncuk/.config/eww/dock-cancel-hide.sh trigger-left"
    (box :class "dock-trigger")))

(defwindow dock
  :monitor 0
  ; Content-sized: width 1px is only a minimum. With :resizable false GTK
  ; tracks the content's natural width and Eww 0.5 re-anchors the window to
  ; bottom center on every resize. dock-apps.py caps it at the monitor width.
  :geometry (geometry :x "0px" :y "0px" :width "1px" :height "82px" :anchor "bottom center")
  :resizable false
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore true
  :class "dock-window"
  (revealer
    :halign "center"
    :valign "end"
    :reveal true
    :transition "slideup"
    :duration "220ms"
    (eventbox
      :onhover "/home/boncuk/.config/eww/dock-cancel-hide.sh"
      :onhoverlost "/home/boncuk/.config/eww/dock-schedule-hide.sh"
      (box :orientation "vertical" :space-evenly false
        ; Right-click popover: revealed above the icons, inside the dock
        ; window so interacting with it keeps the hover veto alive.
        (revealer :reveal menu-open :transition "slideup" :duration "150ms"
          (box :class "ctx-menu" :orientation "vertical" :space-evenly false :halign "center"
            ; Eww 0.5 captures initial :visible on first map. Keep children
            ; visible and gate layout with nonanimated inner revealers instead.
            (revealer :reveal menu-has-desktop :transition "none" :duration "0ms"
              (button :class "ctx-item" :timeout "5s"
                :onclick "/home/boncuk/.config/eww/dock-menu.sh pin"
                {menu-pinned ? "Unpin from dock" : "Pin to dock"}))
            (button :class "ctx-item" :timeout "5s"
              :onclick "/home/boncuk/.config/eww/dock-menu.sh closeopen"
              {menu-running ? "Close window" : "Open"})
            ; Numbered workspaces only (1-10): i3 maps `workspace number N`
            ; onto `N: name` variants, so named-numbered setups just work.
            ; Pure-named workspaces (no leading number) are not listed.
            (revealer :reveal menu-running :transition "none" :duration "0ms"
              (box :orientation "vertical" :space-evenly false
              (button :class "ctx-item" :timeout "5s"
                :onclick "/home/boncuk/.config/eww/dock-move-toggle.sh"
                {menu-move-open ? "Move to workspace ▾" : "Move to workspace ▸"})
              (revealer :reveal menu-move-open :transition "slideup" :duration "150ms"
                ; Even spread suits a 1-10 strip (and keeps it clear of the
                ; left edge under the centered text rows above).
                (box :class "ws-grid" :space-evenly true :halign "center"
                (button :class "ws-item" :timeout "5s" :onclick "/home/boncuk/.config/eww/dock-menu.sh moveto 1" "1")
                (button :class "ws-item" :timeout "5s" :onclick "/home/boncuk/.config/eww/dock-menu.sh moveto 2" "2")
                (button :class "ws-item" :timeout "5s" :onclick "/home/boncuk/.config/eww/dock-menu.sh moveto 3" "3")
                (button :class "ws-item" :timeout "5s" :onclick "/home/boncuk/.config/eww/dock-menu.sh moveto 4" "4")
                (button :class "ws-item" :timeout "5s" :onclick "/home/boncuk/.config/eww/dock-menu.sh moveto 5" "5")
                (button :class "ws-item" :timeout "5s" :onclick "/home/boncuk/.config/eww/dock-menu.sh moveto 6" "6")
                (button :class "ws-item" :timeout "5s" :onclick "/home/boncuk/.config/eww/dock-menu.sh moveto 7" "7")
                (button :class "ws-item" :timeout "5s" :onclick "/home/boncuk/.config/eww/dock-menu.sh moveto 8" "8")
                (button :class "ws-item" :timeout "5s" :onclick "/home/boncuk/.config/eww/dock-menu.sh moveto 9" "9")
                (button :class "ws-item" :timeout "5s" :onclick "/home/boncuk/.config/eww/dock-menu.sh moveto 10" "10")))))))
        ; Do not paint colored chrome while the listener is prefetching icons.
        (revealer :reveal {app-buttons != "(box)"} :transition "none" :duration "0ms"
          ; dock-apps.py emits the colored .dock-main pill, wrapped in a
          ; monitor-width scroll only when the taskbar would overflow.
          (literal :content app-buttons))))))


; Small audio popover opened from Polybar's volume indicator.
(deflisten volume-state
  :initial "{\"volume\": 50, \"muted\": false}"
  "/home/boncuk/.config/eww/volume-listen.sh")

(defwidget volume-control []
  (box :class "volume-card" :orientation "vertical" :space-evenly false
    (box :class "volume-head" :space-evenly false :valign "center"
      (box :orientation "vertical" :space-evenly false :hexpand true
        (label :class "volume-title" :text "Ses düzeyi" :halign "start")
        (label :class "volume-state-label"
          :text {volume-state.muted ? "Sessiz" : "Ses çıkışı"}
          :halign "start"))
      (button :class {volume-state.muted ? "volume-mute is-muted" : "volume-mute"}
        :onclick "pactl set-sink-mute @DEFAULT_SINK@ toggle"
        {volume-state.muted ? "Sesi aç" : "Sessize al"}))
    (box :class "volume-slider-row" :space-evenly false :valign "center"
      (scale :class "volume-slider" :min 0 :max 100
        :value {volume-state.volume}
        :draw-value false
        :hexpand true
        :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")
      (label :class "volume-value" :text "${volume-state.volume}%" :halign "end"))))

(defwindow volume-popup
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "292px" :height "112px" :anchor "top left")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore true
  :class "volume-popup-window"
  (volume-control))
