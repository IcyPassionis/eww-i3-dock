(deflisten app-buttons
  :initial "(box)"
  "/home/boncuk/.config/eww/dock-apps.py --listen")

(defwindow dock_open_area
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "760px" :height "4px" :anchor "bottom center")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore true
  :class "dock-open-area"
  (eventbox
    :onhover "/home/boncuk/.config/eww/dock-show.sh"
    (box :class "dock-trigger")))

(defwindow dock
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "760px" :height "82px" :anchor "bottom center")
  :stacking "fg"
  :windowtype "dock"
  :wm-ignore true
  :class "dock-window"
  (revealer
    :halign "center"
    :valign "end"
    :reveal true
    :transition "slideup"
    :duration "220ms"
    (eventbox
      :onhover "/home/boncuk/.config/eww/dock-cancel-hide.sh"
      :onhoverlost "/home/boncuk/.config/eww/dock-schedule-hide.sh"
      (box :class "dock-main" :space-evenly false :hexpand false
        (literal :content app-buttons)))))
